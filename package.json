{
  "name": "techit-llc",
  "version": "1.0.0",
  "description": "Techit LLC — holding company website for regional digital platforms (Astro)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:watch:css\" \"astro dev\"",
    "start": "astro dev",
    "build": "npm run build:icons && npm run build:css && astro build",
    "build:icons": "node scripts/generate-icons.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify --watch",
    "preview": "astro preview",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.15",
    "astro": "^7.4.0",
    "lucide": "0.469.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.10"
  }
}
