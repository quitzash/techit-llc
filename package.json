{
  "name": "techit-llc",
  "version": "1.0.0",
  "description": "Techit LLC — holding company website for regional digital platforms (Node.js + Express)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"npm:watch:css\" \"npm:dev:server\"",
    "dev:server": "nodemon server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify --watch"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "gsap": "^3.12.5",
    "helmet": "^7.1.0",
    "lenis": "^1.1.14",
    "lucide": "0.469.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10"
  }
}